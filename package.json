{
  "name": "squadly",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Squadly — Find your squad. Play together. Production Web App, Native Mobile App (Capacitor & Expo) & Web Admin Panel (Release 1 v1.1)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:server": "node --experimental-sqlite --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --experimental-sqlite server/index.js",
    "db:migrate": "node --experimental-sqlite server/migrate-pg.js",
    "db:migrate-pg": "node --experimental-sqlite server/migrate-pg.js",
    "mobile:sync": "npx cap sync",
    "mobile:build": "vite build && npx cap sync android",
    "mobile:apk": "cmd /c \"cd android && gradlew.bat assembleDebug\"",
    "mobile:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
